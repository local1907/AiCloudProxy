<Window x:Class="AiCloudProxy.Views.QuickTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:AiCloudProxy.Infrastructure"
        Title="Quick Tour — AI Cloud Proxy"
        Width="600" Height="640"
        MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🚀 Welcome to AI Cloud Proxy" FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="{x:Static infra:AppInfo.VersionLabel}" FontSize="12"
                           Foreground="#6B7280" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
            </StackPanel>
            <TextBlock Text="A 30-second quick tour — what to do, where, and when it works."
                       FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Steps -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Pick your AI provider" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="On the Proxy Server tab, choose a provider from the list (DeepSeek, OpenAI, Claude, Gemini…). Need your own endpoint? Type a name in the “Custom AI provider” box and click Add."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                            <TextBlock Text="For a custom provider, enter its full API path as the Base URL (e.g. https://openrouter.ai/api/v1) — the app appends /chat/completions and /models to it."
                                       FontSize="11" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Enter your API key" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="Paste your key into the API Key field on the right. It is saved only on your machine — tick Show to reveal it."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Choose a default model" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="Select a model, or click Get Models to fetch what your provider offers. Tools that request unknown model names fall back to this one."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Start the proxy" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="Keep the port (default 11435) and click Start — the status turns green. Now any Ollama-compatible tool simply points at http://127.0.0.1:11435. That’s it, nothing else to configure."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="5" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Verify on the Test tab" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="Open the Test tab, pick a model (or type one), type a question, and send it. The reply is shown as model@Provider, so you can see exactly which model answered — a reply means your provider, key and model are wired up correctly."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="6" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Make it automatic (optional)" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="In Options, turn on Auto-start proxy to launch with the app, and Minimize to tray to keep it running when you close the window."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#DC2626"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="7" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Report inappropriate AI output" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Text="Responses come from the AI model you chose and may be inaccurate or inappropriate. Click “Report an Issue” (in the top-right corner and next to the response on the Test tab) and your email app opens with the details pre-filled so the output can be reviewed."
                                       FontSize="12" Foreground="#374151" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="You can reopen this tour anytime from the “Quick Tour” button in the top-right corner."
                       FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Button Content="Got it — let’s start" Click="OnGotItClick"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="170"/>
        </StackPanel>
    </Grid>
</Window>
